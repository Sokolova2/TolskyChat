.p-1
  .d-flex.align-items-center.ps-2.gap-5
    = link_to room_path(room),
      data: { turbo_frame: "_top" },
      class: "conversation-link text-decoration-none text-light pe-4" do
      .name-conversation
        .d-flex.gap-2.align-items-center
          .avatar-wrapper
            - if room.is_a?(PersonalChat)
              = image_tag room.display_avatar(current_user)&.url, size: 42, class: 'rounded-2'
            - else
              %span.bg-dark.text-white.text-center.align-content-center.pt-2.pb-2.ps-3.pe-3.rounded-2.fs-5= room.display_name(current_user)
          %p.p-0.m-0= room.display_name(current_user)

    = button_to room_path(room),
      method: :delete,
      data: { turbo_confirm: 'Delete?' },
      class: 'btn text-light' do
      %i.bi.bi-trash3