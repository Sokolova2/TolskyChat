.body-page
  .conversations-block.pt-2
    .me-5
      %h5.text-light.ps-2.pb-3.me-5 TolskyChat
    = turbo_frame_tag "conversations_list" do
      - @conversations.each do |conversation|
        .d-flex.align-items-center.gap-5.ps-2
          = link_to conversation_path(conversation),
            class: "conversation-link text-decoration-none text-light",
            data: { turbo: false } do
            .name-conversation
              %p.p-0.m-0= conversation.name
          = button_to conversation_path(conversation), method: :delete, data: { turbo_confirm: 'Delete?' }, class: 'btn text-light' do
            %i.bi.bi-trash3