= turbo_frame_tag 'modal' do
  = link_to users_path, class: 'text-decoration-none text-dark' do
    %i.bi.bi-arrow-left.fs-3
  = image_tag @user.avatar.url, class: 'w-100'
  - if @user.first_name.present?
    %p.fs-3.text-center= @user.first_name
  - else
    %p.fs-3.text-center= @user.login
  .card.shadow-sm.mb-3
    .list-group.list-group-flush

      .list-group-item
        %small.text-muted Mobile phone
        %p.mb-0
          - if @user.phone_number.present?
            = @user.phone_number
          - else
            no information

      .list-group-item
        %small.text-muted Login
        %p.mb-0= @user.login

      - if @user.birth_date.present?
        .list-group-item
          %small.text-muted Date of birth
          %p.mb-0= @user.birth_date

      - if @user.description.present?
        .list-group-item
          %small.text-muted About me
          %p.mb-0= @user.description