- blob = attachment.attachable


- if blob.audio?
  .audio-message.mt-2
    %p.text-muted.small= blob.filename.to_s
    %audio{ controls: true }
      %source{ src: url_for(blob), type: blob.content_type }
- elsif blob.video?
  %video{ controls: true, width: 300, class: "mt-2 rounded" }
    %source{ src: url_for(blob), type: blob.content_type }
- elsif blob.image?
  - modal_id = "modal_#{blob.id}"
  %button.btn{"data-bs-target" => "##{modal_id}", "data-bs-toggle" => "modal", :type => "button"}
    = image_tag url_for(blob), width: 300, class: "mt-2"
  .modal.fade.image-modal{id: modal_id, "aria-hidden" => "true", :tabindex => "-1", "data-bs-dismiss" => "modal"}
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-body{ style: "position: relative;" }
          .image-wrapper
            = link_to url_for(blob), download: blob.filename.to_s, class: "download-btn" do
              %i.bi.bi-download.fs-3
            = image_tag url_for(blob), class: "img-fluid"
- else
  = link_to url_for(blob), target: "_blank", class: "text-decoration-none text-dark" do
    .file-card.mt-2
      .d-flex.align-items-center.justify-content-between
        .d-flex.align-items-center.gap-2
          .file-icon
            - if blob.content_type == "application/pdf"
              📄
            - elsif blob.content_type.include?("word")
              📘
            - elsif blob.content_type.include?("excel")
              📊
            - elsif blob.content_type.include?("zip")
              📦
            - else
              📁

          .file-info.me-2
            %p.mb-0.fw-bold= blob.filename.to_s
            %small.text-muted= number_to_human_size(blob.byte_size)

        = link_to url_for(blob), download: blob.filename.to_s, class: "btn btn-sm btn-outline-dark" do
          %i.bi.bi-download