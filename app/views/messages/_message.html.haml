.message{ id: "message_#{message.id}", data: { controller: "context-menu", context_menu_room_id_value: message.room_id } }
  .d-flex.gap-2.align-items-start.ps-3
    = image_tag message.user.avatar.url, class: "chat-avatar"
    .message-body
      %b= message.user.login
      .message-content
        - if message.content&.body&.attachments.present?
          - message.content.body.attachments.each do |attachment|
            = render 'messages/blobs', attachment: attachment
        -  text = message.content.to_s

        - if text.present?
          = text
        - if message.audio_file.attached?
          .audio-message.mt-2
            %audio{ controls: true }
              %source{ src: url_for(message.audio_file), type: message.audio_file.content_type }
      .context-menu.hidden
        %button{ data: { action: "click->context-menu#delete" }, class: 'btn btn-outline-dark text-white' } Delete
    %p= message.created_at.strftime("%H:%M")

