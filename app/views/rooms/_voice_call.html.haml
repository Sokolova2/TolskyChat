- if second_user.present?
  %div{ :data => {controller: "voice",
            voice_current_user_id_value: current_user.id,
            voice_current_user_login_value: current_user.login,
            voice_current_user_avatar_url_value: current_user.avatar_url,
            voice_other_user_id_value: second_user.id,
            voice_caller_id_value: current_user.id,
            voice_ice_servers_value: voice_ice_servers.to_json}
            }
    %button.btn.btn-primary{ data: { action: "voice#start",
              voice_other_user_id: second_user.id,
              voice_caller_id: current_user.id
              }
            }
      📞 Start Call
    %button#returnToCall.btn.btn-success.d-none{ data: { action: "voice#returnToCall" } }
      🔙 Back to call
    = render 'rooms/outgoing', second_user: second_user
    = render 'rooms/incoming', second_user: second_user
    = render 'rooms/active', second_user: second_user