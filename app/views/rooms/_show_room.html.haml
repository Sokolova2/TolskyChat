.chat-container.container-content.bg-light
  .chat-header.shadow-lg
    .d-flex.justify-content-between.align-items-center.ms-3.me-3.p-3
      .d-flex.gap-2
        - second_user = room.participants.includes(:user).map(&:user).find{ |u| u.id != current_user.id }
        - if room.is_a?(Conversation)
          %h5= room.name
          - if room.is_private?
            %p.text-secondary private
          - elsif room
            %p.text-secondary public
          %button.btn.btn-outline-dark.ms-1{ 'data-bs-toggle' => 'modal', 'data-bs-target' => '#conversationModal' }
            %i.bi.bi-three-dots
          .modal.fade#conversationModal{ tabindex: '-1', 'aria-hidden' => 'true' }
            .modal-dialog
              .modal-content
                .modal-body
                  = render 'rooms/conversation_options', room: room
        - else
          %h5= room.other_user(current_user).login
          - contact = Contact.find_by(sender: current_user, receiver: second_user) || Contact.find_by(sender: second_user, receiver: current_user)
          = link_to contact_path(contact), data: { turbo_frame: "modal" }, class: 'menu-icon' do
            %i.bi.bi-three-dots.btn.btn-outline-dark.ms-1

        %button.btn.btn-primary{ data: { action: "voice#start",
          voice_other_user_id: second_user.id,
          voice_caller_id: current_user.id
          }
        }
          📞 Start Call
        %button#returnToCall.btn.btn-success.d-none{ data: { action: "voice#returnToCall" } }
          🔙 Back to call
        %p{ data: { voice_target: "status" } }
          Idle
        = render 'rooms/outgoing', second_user: second_user
        = render 'rooms/incoming', second_user: second_user
        = render 'rooms/active', second_user: second_user
  #chatroom.chat-messages
    .chat-messages-inner
      = render room.messages.sort_by(&:created_at)
  .chat-input{ data: { controller: "reaction-form audio-recording", "audio-recording-room-id-value": room.id}}
    .audio-controls.d-none{ data: { audio_recording_target: "controls" } }
      %button.btn.btn-outline-dark{ type: "button",
        data: { action: "audio-recording#startRecording",
        "audio_recording_target": "startRecording"
        }
      }
        🎤 Start
      %button.btn.btn-outline-danger{ data: { type: "button",
        action: "audio-recording#stopRecording",
        "audio_recording_target": "stopRecording"
        }
      }
        ⏹ Stop
      %button.btn.btn-outline-warning{ data: { type: "button",
        action: "audio-recording#pauseRecording",
        "audio_recording_target": "pauseRecording"
        }
      }
        ⏸ Pause
      %button.btn.btn-outline-success{ data: { type: "button",
        action: "audio-recording#resumeRecording",
        "audio_recording_target": "resumeRecording"
        }
      }
        ▶ Resume

      %p{ data: { audio_recording_target: "timeElapsed" } } 00:00

    = form_with(model: @message, url: room_messages_path(room), id: "message_form", html: { multipart: true }, data: { controller: 'emoji-picker' }) do |f|
      .field
        = content_tag(:div, "", class: "pickerContainer", data: { emoji_picker_target: "pickerContainer" })
        = f.rich_textarea :content, autofocus: true, data: { controller: "trix-preview", emoji_picker_target: "trixEditor" }
        = f.file_field :featured_image, id: 'file_input', style: 'display:none'
      .actions
        = f.submit 'Send'

    .modal.fade#videoModal.modal-video{ tabindex: "-1" }
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-body
            #video-modal-preview
            %button.btn.btn-secondary{ type: "button", "data-bs-dismiss" => "modal" } Cancel
            %button.btn.btn-dark#sendVideoBtn Send

    .modal.fade#audioModal.modal-audio{ tabindex: "-1" }
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-body
            #audio-modal-preview
            %button.btn.btn-secondary{ type: "button", "data-bs-dismiss" => "modal" } Cancel
            %button.btn.btn-dark#sendAudioBtn Send

    .modal.fade#fileModal.modal-file{ tabindex: "-1" }
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-body
            #file-modal-preview
            %button.btn.btn-secondary{ type: "button", "data-bs-dismiss" => "modal" } Cancel
            %button.btn.btn-dark#sendFileBtn Send

