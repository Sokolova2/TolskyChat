.modal.fade#activeCallModal{ tabindex: "-1" }
  .modal-dialog.modal-dialog-centered
    .modal-content.p-3.text-center
      #videoContainer{ style: "position:relative;background:black; min-height:300px;" }
        %img#avatarFallback{ src: second_user.avatar_url, width: 400 }

        %video#remoteVideo{ autoplay: true,
          playsinline: true,
          style: "width:100%; display:none;"
        }

        %video#localVideo{ autoplay: true,
          playsinline: true,
          muted: true,
          style: "width:120px; position:absolute; bottom:10px; right:10px;"
        }

      %h5= second_user.login

      %p.text-success{ data: { voice_target: "status" } }
        🔊 In call

      %h6#callTimer 00:00

      .d-flex.justify-content-center.gap-2.mt-3

        %button.btn.btn-warning{ data: { action: "voice#toggleMute" } }
          %i.bi.bi-mic
          Mute

        %button.btn.btn-info{ data: { action: "voice#toggleVideo" } }
          %i.bi.bi-camera-video
          Camera

        %button.btn.btn-danger{ data: { action: "voice#endCall" } }
          %i.bi.bi-x-lg
          End