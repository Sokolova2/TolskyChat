%figure{ class: "attachment text-start m-0" }

  - if blob.video?
    - begin
      - preview = blob.preview(resize_to_limit: [300, 200])
      - poster_url = url_for(preview) if preview.processed?
    - rescue
      - poster_url = nil

    %video{ controls: true, class: "mb-3 rounded", style: "max-width: 300px;", poster: poster_url }
      %source{ src: url_for(blob), type: blob.content_type }

  - elsif blob.image?
    = image_tag blob,
      class: "mb-3 rounded",
      style: "max-width: 300px;"

  - else
    = link_to blob.filename, url_for(blob)

  %figcaption.attachment__caption
    - if caption = blob.try(:caption)
      = caption