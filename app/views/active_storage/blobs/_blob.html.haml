%figure{:class => "attachment text-start m-0 attachment--#{blob.representable? ? "preview" : "file"} attachment--"}
- if blob.representable?
  = image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [ 200, 150 ] : [ 200, 150 ]), class: 'mb-4'
%figcaption.attachment__caption
- if caption = blob.try(:caption)
  = caption
