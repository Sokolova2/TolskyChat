= turbo_frame_tag "modal" do
  = link_to contacts_path, class: 'text-decoration-none text-dark' do
    %i.bi.bi-arrow-left.fs-3
  = image_tag @user.avatar.url, class: 'w-100'
  - if @user.first_name.present?
    %p.fs-3.text-center= @user.first_name
  - else
    %p.fs-3.text-center= @user.login

  .d-flex.justify-content-between.align-items-center.mb-3
    = button_to 'Create chat', personal_chats_path, method: :post,
      params: { personal_chat: { second_user_id: @user.id } },
      form: { data: { turbo_frame: '_top' } },
      class: 'text-decoration-none text-white btn btn-dark'
    - if @contact.blocked == false
      = button_to 'Block', contact_path(@contact), method: :patch, params: { blocked: true },
    class: 'text-decoration-none text-white btn btn-dark'
    - else
      = button_to 'Unlock', contact_path(@contact), method: :patch, params: { blocked: false },
    class: 'text-decoration-none text-white btn btn-dark'

  .card.shadow-sm.mb-3
    .list-group.list-group-flush

      .list-group-item
        %small.text-muted Mobile phone
        %p.mb-0
          - if @user.phone_number.present?
            = @user.phone_number
          - else
            no information

      .list-group-item
        %small.text-muted Login
        %p.mb-0= @user.login

      - if @user.birth_date.present?
        .list-group-item
          %small.text-muted Date of birth
          %p.mb-0= @user.birth_date

      - if @user.description.present?
        .list-group-item
          %small.text-muted About me
          %p.mb-0= @user.description
