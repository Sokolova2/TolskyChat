= turbo_frame_tag 'modal' do
  %h1.text-center.mb-3 Your contacts
  = form_with(url: contacts_path, method: :get, data: { controller: 'search', turbo_frame: 'contacts-search' }) do |f|
    = f.text_field :search, value: params[:search], placeholder: 'Search contacts...',
      data: { action: 'input->search#search' }, class: 'form-control rounded-5 p-2 text-center search'
  = turbo_frame_tag 'contacts-search' do
    - if @contacts.present?
      .card.shadow-sm.mt-3
        .list-group.list-group-flush
          - @contacts.each do |contact|
            .list-group-item{ id: dom_id(contact) }
              .d-flex.align-items-center
                = render 'contacts/contacts', contact: contact, current_user: current_user
    - else
      %p.text-center.text-muted.mt-4
        You don’t have any contacts yet
