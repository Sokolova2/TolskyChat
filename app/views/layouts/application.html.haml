!!!
%html
  %head
    %meta{ :content => 'text/html; charset=UTF-8', 'http-equiv' => 'Content-Type' }/
    %title= content_for(:title) || 'Tolsky Chat'
    %meta{ content: 'width=device-width,initial-scale=1', name: 'viewport' }/
    %meta{ content: 'yes', name: 'apple-mobile-web-app-capable' }/
    %meta{ content: 'Tolsky Chat', name: 'application-name' }/
    %meta{ content: 'yes', name: 'mobile-web-app-capable' }/
    = csrf_meta_tags
    = csp_meta_tag
    %link{ href: '/icon.png', rel: 'icon', type: 'image/png' }/
    %link{ href: '/icon.svg', rel: 'icon', type: 'image/svg+xml' }/
    %link{ href: '/icon.png', rel: 'apple-touch-icon' }/
    = stylesheet_link_tag :application, 'data-turbo-track': Rails.env.production? ? 'reload' : ''
    = javascript_importmap_tags
    = action_cable_meta_tag
    - if user_signed_in?
      %meta{ name: 'current-user-id', content: current_user.id }
  %body.body{ data: {
    controller: 'web-push-notification',
    web_push_notification_vap_value: Base64.urlsafe_decode64(
      ENV.fetch('VAPID_PUBLIC_KEY')).bytes
    } }
    .position-fixed.top-0.start-50.translate-middle-x.mt-3.w-100.px-3{ style: 'z-index: 3000; max-width: 720px;' }
      - if alert
        .alert.alert-danger.mb-2= alert
      - if notice
        .alert.alert-success.mb-0= notice
    = yield
